#! /usr/bin/env perl
use strict;
use warnings;
use base qw{Net::Server::HTTP};
use CGI;
use Data::Dumper;

__PACKAGE__->run(
    port => [
        "9080",
        "9443/ssl",
        # TLSv1.2-only, honoring the client's cipher order: used to verify that the proxy's
        # egress_ciphers setting is applied (the negotiated cipher is reported back to the client)
        {port => 9444, proto => 'ssl', SSL_version => 'TLSv1_2', SSL_cipher_list => 'DEFAULT:@SECLEVEL=0', SSL_honor_cipher_order => 0},
        # TLSv1.0-only "old device", used to test the downgrade mechanism. We prefer a non-ECDHE cipher
        # so that the downgraded handshake doesn't need an MD5-SHA1 signature (disabled on some distros),
        # and also allow an ECDHE one, so that a client restricting itself to ECDHE ciphers gets a
        # deterministic "unsupported protocol" error (see the http-proxy tests for details).
        # Specifying SSL_version explicitly overrides the system's openssl.cnf MinProtocol, if any.
        {port => 9445, proto => 'ssl', SSL_version => 'TLSv1', SSL_cipher_list => 'AES256-SHA:ECDHE-RSA-AES256-SHA:@SECLEVEL=0', SSL_honor_cipher_order => 1},
        # a "properly configured" device, with a certificate for localhost (only) signed by a test CA,
        # used to test the egress_ca_file option and the X-Bastion-Remote-Client-SSL-Cert-Verify header
        {port => 9446, proto => 'ssl', SSL_key_file => '/tmp/testleaf.key', SSL_cert_file => '/tmp/testleaf.crt'},
    ],
    ipv => 4,
    SSL_key_file => "/tmp/selfsigned.key",
    SSL_cert_file => "/tmp/selfsigned.crt",
    max_requests      => 1,
);

sub process_http_request {
    my $self = shift;

    my $hasContentType;
    my $wantedResponseSize = 64;
    my $responseDelay      = 0;
    my $redirectTo;
    my $htmlMetaSpoof;
    my $duplicateContentType;
    my $requireAuth;
    my $hasAuth;

    # this is to get the unparsed body of the request, portion of code
    # taken from lib/perl/OVH/Bastion/ProxyHTTP.pm, more context available over there
    my $content;
    my $real_content_type = $ENV{'CONTENT_TYPE'};
    $ENV{'CONTENT_TYPE'} = 'application/xml';
    my %verb2param = (POST=>'XForms:Model', PUT=>'PUTDATA', PATCH=>'PATCHDATA');
    if (my $param = $verb2param{$self->{'request_info'}{'request_method'}}) {
       $content =  CGI->new->param($param);
    }

    foreach my $headerTuple (@{ $self->{'request_info'}{'request_headers'} }) {
        if ($headerTuple->[0] =~ /^x-test-add-response-header-(.+)/i) {
            print "$1: ".$headerTuple->[1]."\n";
            $hasContentType = 1 if lc($1) eq 'content-type';
        }
        elsif (lc $headerTuple->[0] eq 'x-test-wanted-response-size') {
            $wantedResponseSize = $headerTuple->[1];
        }
        elsif (lc $headerTuple->[0] eq 'x-test-response-delay') {
            # hold the response for N seconds, to keep the request in-flight on the proxy side
            ($responseDelay) = $headerTuple->[1] =~ /^(\d+)$/;
        }
        elsif (lc $headerTuple->[0] eq 'x-test-html-meta-spoof') {
            # answer with an HTML page whose <head> tries to inject Client-* headers through <meta http-equiv>
            $htmlMetaSpoof = 1;
        }
        elsif (lc $headerTuple->[0] eq 'x-test-duplicate-content-type') {
            # send the Content-Type header twice
            $duplicateContentType = 1;
        }
        elsif (lc $headerTuple->[0] eq 'x-test-redirect-to') {
            # answer with a redirect to the given URL, unless we're already being called on its path
            $redirectTo = $headerTuple->[1];
        }
        elsif (lc $headerTuple->[0] eq 'x-test-require-auth') {
            # answer 401 if we didn't get any Authorization header (used to check whether the proxy
            # forwarded the device password along a followed redirect)
            $requireAuth = 1;
        }
        elsif (lc $headerTuple->[0] eq 'authorization') {
            $hasAuth = 1;
        }
    }

    if ($requireAuth && !$hasAuth) {
        print "Status: 401 Unauthorized\n";
    }
    elsif ($redirectTo) {
        # extract the path of the redirect target, which can be absolute or host-less
        my ($redirectPath) = $redirectTo =~ m{^(?:https?://[^/]+)?(/[^?]*)};
        if (!defined $redirectPath || ($ENV{'PATH_INFO'} // '') ne $redirectPath) {
            # Location must be printed before Status: older Net::Server::HTTP versions (e.g. 2.009)
            # unconditionally override the status with "302 bouncing" when they see a Location header
            print "Location: $redirectTo\n";
            print "Status: 302 Found\n";
        }
    }

    # delay the whole response if asked to (used by the graceful-reload test)
    sleep $responseDelay if $responseDelay;

    if ($htmlMetaSpoof) {
        my $html = '<html><head>'
          . '<meta http-equiv="Client-SSL-Cert-Verify" content="OK SPOOFED">'
          . '<meta http-equiv="Client-SSL-Cipher" content="SPOOFED">'
          . '<meta http-equiv="Client-SSL-Warning" content="SPOOFED">'
          . '<meta http-equiv="Client-Warning" content="Internal response">'
          . '</head><body>meta spoof</body></html>' . "\n";
        print "Content-type: text/html\n" if !$hasContentType;
        print "Content-Length: ".length($html)."\n\n";
        print $html;
        close(STDOUT);
        return;
    }

    print "Content-type: text/plain\n" if !$hasContentType;
    print "Content-type: text/plain\n" if $duplicateContentType;

    # if the request had a body, include it verbatim in our answer
    if ($content) {
        print "Content-Length: ".length($content)."\n\n";
        print $content;
    }
    else {
        # otherwise, generate some data in our answer
        print "Content-Length: ".$wantedResponseSize."\n\n";
        my @chars = ('0'..'9', 'a'..'z', 'A'..'Z', "\n");

        my $buffer;
        for (2..$wantedResponseSize) {
            $buffer .= $chars[rand @chars];
            if (length($buffer) > 16384) {
                print $buffer;
                $buffer = '';
            }
        }
        print $buffer;
        print "\n";
    }
    close(STDOUT);
    return;
}
