#! /usr/bin/perl -T
# vim: set filetype=perl ts=4 sw=4 sts=4 et:
# FILEMODE 0755
# FILEOWN root root
use 5.026;
use common::sense;

use File::Basename;
use lib dirname(__FILE__) . '/../../lib/perl';
use OVH::Result;
use OVH::Bastion;

use Fcntl qw(:flock SEEK_END);
use Getopt::Long;
use HTTP::Message;
use IO::Pipe;
use IO::Select;
use IO::Socket::SSL;
use Net::SSLeay;
use LWP::UserAgent;
use MIME::Base64;
use POSIX    ();
use Storable qw{ freeze thaw };
use Sys::Hostname;
use Time::HiRes ();
use URI;
use List::Util qw{ first };

$ENV{'FORCE_STDERR'} = 1;
$ENV{'PATH'}         = '/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/pkg/bin';

my $uniqid;
my $fnret;
my %log_params = (
    'cmdtype'     => 'proxyhttp_worker',
    'uniq_id'     => $uniqid,
    'bastionip'   => $ENV{'SERVER_ADDR'},
    'bastionport' => $ENV{'SERVER_PORT'},
    'ipfrom'      => $ENV{'REMOTE_ADDR'},
    'portfrom'    => $ENV{'REMOTE_PORT'},
    'custom'      => [[user_agent => $ENV{'HTTP_USER_AGENT'}]],
);

# to handle child timeout
my $child_finished = 0;
$SIG{'CHLD'} = sub { wait; $child_finished = 1 };

my @headers;

sub log_and_exit {
    my ($code, $msg, $body, $params) = @_;

    my %merged = (%log_params, %$params);

    $merged{'allowed'} //= 0;

    # custom data will only be logged to logfile and syslog, not sql (it's not in the generic schema)
    push @{$merged{'custom'}}, ['code' => $code], ['msg' => $msg];
    OVH::Bastion::log_access_insert(%merged);

    if (!first { "X-Bastion-Local-Status" eq $_->[0] } @headers) {
        push @headers, ["X-Bastion-Local-Status" => "$code $msg"];
    }
    my %ret = (code => $code, msg => $msg, body => $body, headers => \@headers, allowed => $merged{'allowed'});
    OVH::Bastion::json_output(R('OK', value => encode_base64(freeze(\%ret))), no_delimiters => 1);
    exit 0;
}

my $pass = delete $ENV{'PROXY_ACCOUNT_PASSWORD'};
my $content;

GetOptions(
    "account=s"                       => \my $account,
    "user=s"                          => \my $user,
    "group=s"                         => \my $group,
    "context=s"                       => \my $context,
    "host=s"                          => \my $remotemachine,
    "port=i"                          => \my $remoteport,
    "method=s"                        => \my $method,
    "path=s"                          => \my $path,
    "header=s"                        => \my @client_headers,
    "timeout=i"                       => \my $timeout,
    "insecure"                        => \my $insecure,
    "uniqid=s"                        => \$uniqid,
    "post-data-stdin"                 => \my $postDataStdin,
    "allow-downgrade"                 => \my $allow_downgrade,
    "monitoring"                      => \my $monitoring,
    "log-request-response"            => \my $log_request_response,
    "log-request-response-max-size=i" => \my $log_request_response_max_size,
    "egress-protocol=s"               => \my $egress_protocol,
);
push @headers, ["X-Bastion-Remote-Host" => $remotemachine];

# the daemon normally passes --post-data-stdin and feeds the body on our STDIN (below). The env
# branch is the fallback for the upgrade window: a not-yet-restarted daemon runs the previous in-RAM
# code and still passes the body via PROXY_POST_DATA. Keep it until that path is no longer possible.
if (!$postDataStdin) {
    # TODO: remove this a few releases after --post-data-stdin is shipped.
    $content = delete $ENV{'PROXY_POST_DATA'};
    $content = decode_base64($content) if $content;
}
else {
    binmode STDIN;
    local $/ = undef;
    $content = <STDIN>;
    $content //= '';    # readline returns undef on an empty stream (e.g. a body-less GET)
}
push @headers, ["X-Bastion-Request-Length" => "" . length($content)];

# if we're being called by the monitoring, just exit happily
if ($monitoring) {
    my %ret = (code => 200, msg => 'OK', body => $OVH::Bastion::VERSION, allowed => 1);
    OVH::Bastion::json_output(R('OK', value => encode_base64(freeze(\%ret))), no_delimiters => 1);
    exit 0;
}

$egress_protocol ||= "https";

$fnret = OVH::Bastion::is_bastion_account_valid_and_existing(account => $account);    # time: 20ms
$fnret or log_and_exit(400, "Bad Request (bad account)", "Account name is invalid\n", {comment => "invalid_account"});
$account = $fnret->value->{'account'};                                                # untaint

# re-validate the remote user here, the daemon already checks this, but as a privileged helper
# we must revalidate everything that is passed on to us
if (!defined $user || !($fnret = OVH::Bastion::is_valid_remote_user(user => $user, stricter => 1))) {
    log_and_exit(400, "Bad Request (bad user name)", "User name is invalid\n", {comment => "bad_user_name"});
}
$user = $fnret->value;    # untaint

$log_params{'account'} = $account;
$log_params{'user'}    = $user;
$log_params{'hostto'}  = $remotemachine;
$log_params{'params'}  = $path;
$log_params{'plugin'}  = uc("$egress_protocol/$method");
push @{$log_params{'custom'}}, ['post_length' => length($content)];

# hardcoded list of protocols we support
if (!grep { $egress_protocol eq $_ } qw{ http https }) {
    log_and_exit(400, "Bad Request (bad protocol)", "Egress protocol is invalid\n", {comment => "invalid_protocol"});
}

# check egress protocol against the list of allowed ones
$fnret = OVH::Bastion::load_configuration_file(
    file   => OVH::Bastion::main_configuration_directory() . "/osh-http-proxy.conf",
    secure => 1,
);
if (not $fnret) {
    osh_warn "Error loading configuration: $fnret";
    log_and_exit(
        500,
        "Internal Error",
        "Configuration is invalid, please contact the bastion admin\n",
        {comment => "invalid_configuration"}
    );
}

my $config = $fnret->value();

# only look at the egress protocols, allowed methods and redirects policy,
# the other configuration values are handled by the daemon, not the worker (us)
$config->{'allowed_egress_protocols'} ||= ['https'];    # default value
if (ref $config->{'allowed_egress_protocols'} ne 'ARRAY') {
    osh_warn "Invalid allowed_egress_protocols config type: " . (ref $config->{'allowed_egress_protocols'});
    log_and_exit(
        500,
        "Internal Error",
        "Configuration is invalid, please contact the bastion admin\n",
        {comment => "invalid_configuration"}
    );
}

$config->{'allow_redirects'} //= 'same-host';           # default value
if (not grep { $config->{'allow_redirects'} eq $_ } qw{ none same-host any }) {
    osh_warn "Invalid allow_redirects config value: " . $config->{'allow_redirects'};
    log_and_exit(
        500,
        "Internal Error",
        "Configuration is invalid, please contact the bastion admin\n",
        {comment => "invalid_configuration"}
    );
}

# if specified, egress_ca_file must be an absolute path to a readable file:
# never silently fall back to the default CA store if it's not
my $egress_ca_file;
if (defined $config->{'egress_ca_file'} && $config->{'egress_ca_file'} ne '') {
    # untaint: this comes from our root-owned config file, loaded in secure mode
    if ($config->{'egress_ca_file'} =~ m{^(/[^\0]+)$} && -f $1 && -r $1) {
        $egress_ca_file = $1;
    }
    else {
        # this must reach the system logs, so that an admin can see it
        # the worker runs under the identity of the bastion account, so the file must be readable by all of them
        warn_syslog("osh-http-proxy-worker: invalid egress_ca_file config value, not an absolute path "
              . "to a file readable by the bastion accounts (checked as '$account'): "
              . $config->{'egress_ca_file'});
        log_and_exit(
            500,
            "Internal Error",
            "Configuration is invalid, please contact the bastion admin\n",
            {comment => "invalid_configuration"}
        );
    }
}

if (not grep { $egress_protocol eq $_ } @{$config->{'allowed_egress_protocols'}}) {
    log_and_exit(
        400,
        "Bad Request (forbidden protocol)",
        "Requested protocol '$egress_protocol' is forbidden\n",
        {comment => "forbidden_protocol"}
    );
}

if (not grep { $method eq $_ } @{$config->{'allowed_methods'} || []}) {
    log_and_exit(
        400,
        "Bad Request (method forbidden)",
        "The $method method is forbidden by policy",
        {comment => 'method_forbidden'}
    );
}

my $shortGroup;
if ($group) {
    $fnret = OVH::Bastion::is_valid_group_and_existing(group => $group, groupType => 'key');
    $fnret or log_and_exit(400, "Bad Request (bad group)", "Group name is invalid\n", {comment => "invalid_group"});
    $shortGroup = $fnret->value->{'shortGroup'};
    $group      = $fnret->value->{'group'};
}

if (!OVH::Bastion::is_valid_port(port => $remoteport)) {
    log_and_exit(
        400,
        "Bad Request (bad port number)",
        "Port number is out of range\n",
        {comment => "invalid_port_number"}
    );
}

$log_params{'portto'} = $remoteport;

if (!$timeout || $timeout !~ /^\d+$/ || $timeout < 1) {
    $timeout = 10;
}
elsif ($timeout > 3600) {
    $timeout = 3600;
}

if (not $pass) {
    log_and_exit(400, "Bad Request (no password)", "No password\n", {comment => "missing_password"});
}

# convert the remotemachine into an IP if needed
my $remoteip;
$fnret = OVH::Bastion::get_ip(host => $remotemachine);
if ($fnret && $fnret->value->{'ip'} && $fnret->value->{'ip'} =~ /^([0-9a-f.:]+)$/) {
    $remoteip = $1;    # untaint
}
else {
    my $comment = lc($fnret->err);
    $comment =~ tr/-/_/;
    log_and_exit(400, "Bad Request (" . $fnret->err . ")", "$fnret\n", {comment => $comment});
}
push @headers, ["X-Bastion-Remote-IP" => $remoteip];

delete $log_params{'hostto'};
$log_params{'ipto'} = $remoteip;

# if it's an IPv6, we need to add brackets around it as an URI, and adapt the name of the log subdirectory
my $remotemachine_uri = $remoteip;
my $logsubdir         = $remoteip;
if (index($remotemachine, ':') != -1) {
    $remotemachine_uri = "[$remotemachine]";
    # as :'s might not be allowed on all filesystems, replace :'s by .'s and surround by v6[]
    $logsubdir =~ tr/:/./;
    $logsubdir = "v6[$logsubdir]";
}

# now check that the password we were given for account matches the hash we have stored for it
# first get our stored hash
$fnret = OVH::Bastion::account_config(account => $account, key => "proxyhttphash");
if (not $fnret or not $fnret->value) {

    # bad login because we couldn't open the proper file
    log_and_exit(
        403,
        "Access Denied",
        "No password configured for you, $account\n",
        {comment => "no_password_for_login"}
    );
}
my $storedhash = $fnret->value;
chomp $storedhash;

# extract the salt from the stored hash we have
if ($storedhash !~ /^\$(?<cipher>[a-zA-Z0-9]{1,2})\$(?<salt>[^\$]+)\$[^\$]+$/) {

    # the hash we have stored in the bastion is fucked :(
    log_and_exit(
        500,
        "Internal Error (malformed hash)",
        "Please contact a bastion admin\n",
        {comment => "malformed_hash"}
    );
}

if ($storedhash ne crypt($account . ':' . $pass, '$' . $+{'cipher'} . '$' . $+{'salt'})) {
    log_and_exit(
        403,
        "Access Denied",
        "Incorrect username ($account) or password (#REDACTED#, length=" . length($pass) . ")\n",
        {comment => "bad_login_password"}
    );
}
undef $pass;
undef $storedhash;

# read the password we must use
# pseudoalgo:
# if mode was explicitly specified to group, we look for a group password
# elif mode was explicitly specified to self, we look for a self account password
# elif the legacy file with the same name as $user exists in /home/passkeeper, use it
# elif the specified $user happens to be a group name, look for this group password
# else look for a self account password

my $authmode;
my $hint;
if ($context eq 'group') {
    $hint     = $shortGroup;
    $authmode = 'group/explicit';
}
elsif ($context eq 'self') {
    $hint     = $account;
    $authmode = 'self/explicit';
}
elsif (-f "/home/passkeeper/$user") {
    $hint     = $user;
    $context  = 'legacy';
    $authmode = 'legacy';
}
elsif (OVH::Bastion::is_valid_group_and_existing(group => $user, groupType => "key")) {
    $hint     = $user;
    $context  = 'group';
    $authmode = 'group/guessed';
}
else {
    $hint     = $account;
    $context  = 'self';
    $authmode = 'self/default';
}
push @headers,                 ["X-Bastion-Auth-Mode" => $authmode];
push @{$log_params{'custom'}}, ['auth_mode'           => $authmode];

# check if account or group has the right to access $user@$remoteip, time: 50ms (to re-compute)
$fnret = OVH::Bastion::is_access_granted(
    account  => $account,
    user     => $user,
    ipfrom   => $ENV{'REMOTE_ADDR'},
    ip       => $remoteip,
    port     => $remoteport,
    listOnly => 1,
    sudo     => 1
);
if (not $fnret) {
    log_and_exit(
        403,
        "Access Denied (access denied to remote)",
        "This account doesn't have access to this user\@host tuple ($fnret)\n",
        {comment => "access_denied"}
    );
}
else {
    # check that the way we were asked to use (personal access, group access) is actually allowed for this account
    my $isOk = 0;
    if ($context ne 'legacy') {
        foreach my $access (@{$fnret->value}) {
            if ($access->{'type'} =~ /^group/ && $context eq 'group') {
                $isOk = 1 if $access->{'group'} eq $hint;
            }
            elsif ($access->{'type'} =~ /^personal/ && $context eq 'self') {
                $isOk = 1;
            }
        }
    }
    else {
        # for legacy, we don't check: we didn't know how to differentiate back then
        $isOk = 1;
    }

    if (!$isOk) {
        log_and_exit(
            403,
            "Access Denied (access denied to remote this way)",
            "This account doesn't have access to $user\@$remotemachine_uri:$remoteport using this auth mode ($authmode)\n",
            {comment => "access_denied_this_way"}
        );
    }
}
$log_params{'allowed'} = 1;

$fnret = OVH::Bastion::get_passfile(hint => $hint, context => $context);
if (!$fnret) {
    log_and_exit(412, "Precondition Failed (egress password missing)", "$fnret\n", {comment => "no_password_found"});
}
my $device_password;
if (open(my $pwdfile, '<', $fnret->value)) {
    $device_password = <$pwdfile>;
    close($pwdfile);
    chomp $device_password;
}
else {
    log_and_exit(
        500,
        "Internal Error (egress password unreadable)",
        "Couldn't read the $context '$user' egress password\n",
        {comment => "cannot_read_password"}
    );
}

# when insecure, the reason why LWP wouldn't have accepted the connection if insecure was false, if any (see below):
# either because it wouldn't have found a usable CA store, or because the certificate chain is invalid
my $ca_store_error;
my $cert_chain_error;

# The Client-SSL-* headers we send back to our client (as X-Bastion-Remote-Client-SSL-*) must come from LWP, never
# from the device. Stripping the device's own Client-* headers from the response is not enough, as LWP can add
# headers coming from the device afterwards (HTTP trailers, HTML <meta http-equiv> tags, etc.). So we wrap
# _get_sock_info(), which LWP calls once per response read from a socket, right after having parsed the headers:
# we first strip the device's Client-* headers, then call the real sub, then immediately save the Client-SSL-*
# headers LWP has set into the response object, under our own key. These saved values are the only ones we
# send back to our client. The presence of this key also tells that the response comes from an actual
# connection, and not from LWP itself (internal error responses), which a device could otherwise fake.
my $EGRESS_CONN_KEY = '_bastion_egress_conn';
my @CLIENT_SSL_HEADERS =
  qw{ Client-SSL-Version Client-SSL-Cipher Client-SSL-Cert-Subject Client-SSL-Cert-Issuer Client-SSL-Warning };

# returns true if the response has been generated by LWP itself (e.g. couldn't connect),
# as opposed to a response from the device
sub is_lwp_internal_response {
    my $response = shift;
    return 0 if (!$response || $response->{$EGRESS_CONN_KEY});
    return ($response->header('Client-Warning') // '') eq 'Internal response';
}

# returns the name the given request is meant for, which is the one the certificate must be validated against
# (and sent through SNI). Our requests always connect to the IP we've checked, but carry the Host header with the
# name the client used. The redirects followed by LWP itself (allow_redirects=any) have no Host header, as LWP
# removes it: they connect to the host of their URI, and this is their name
sub egress_name_of {
    my $request = shift;
    return $request->header('Host') // $request->uri->host;
}

# one entry per egress TLS connection attempted by our child (there can be several: downgrade retry, followed
# redirects), describing whether it was (or, when insecure, would have been) accepted with a certificate verification
# enforced, and which TLS version and cipher it used. This is sent back to our parent, which logs it to syslog
# (type http-proxy-tls), to ease the migration to insecure=false, and for TLS compliance statistics.
my @tls_compliance;

# when secure, a connection refused because of an invalid certificate never reaches our _get_sock_info() wrapper,
# as there's no established connection: LWP generates an internal error response instead. We record it from here.
sub record_refused_tls_connection {
    my $response = shift;
    return if ($insecure || !$response || $response->code != 500 || !is_lwp_internal_response($response));
    my $uri = $response->request ? $response->request->uri : undef;
    return if (!$uri || $uri->scheme ne 'https');
    # only record certificate verification failures: other errors (connection refused, timeouts, protocol
    # or cipher mismatches, etc.) are not about the certificate validity. Not all LWP versions include the
    # reason in the message, so also look at the last error of IO::Socket::SSL, which is set by the
    # handshake that just failed in this very process
    my $re       = qr/\b(certificate verify failed|hostname verification failed)\b/;
    my ($reason) = $response->message =~ $re;
    ($reason) = ($IO::Socket::SSL::SSL_ERROR // '') =~ $re if !$reason;
    return if !$reason;
    my $uri_host = $uri->host;
    push @tls_compliance,
      {
        host         => egress_name_of($response->request),
        ip           => (OVH::Bastion::is_valid_ip(ip => $uri_host, fast => 1) ? $uri_host : ''),
        port         => $uri->port,
        verdict      => 'failed',
        reason       => $reason,
        ssl_version  => '',
        ssl_cipher   => '',
        cert_subject => '',
        cert_issuer  => '',
      };
    return;
}

## no critic (TestingAndDebugging::ProhibitNoWarnings, Variables::ProtectPrivateVars)
{
    no warnings 'redefine';
    require LWP::Protocol::http;
    my $orig_get_sock_info = \&LWP::Protocol::http::_get_sock_info;
    *LWP::Protocol::http::_get_sock_info = sub {
        my ($self, $response, $sock, @rest) = @_;
        foreach my $name ($response->headers->header_field_names) {
            next if $name !~ /^client-/i || lc($name) eq 'client-junk';
            $response->remove_header($name);
        }
        my @ret = $orig_get_sock_info->($self, $response, $sock, @rest);

        # the Client-SSL-* headers set by LWP are saved by our LWP::Protocol::https::_get_sock_info() wrapper below,
        # as LWP sets them there, after having called us
        my %conn = (headers => {});
        $response->{$EGRESS_CONN_KEY} = \%conn;

        # record the TLS details of each egress TLS connection, for our compliance logs. We do it here because this
        # is called for the socket of each response, which also covers the downgrade retry and the followed redirects.
        # When insecure, we also compute whether the connection would have been accepted if insecure was false
        # (see where $cert_chain_error is set for details), and report it to our client. When secure, the connection
        # wouldn't have been established if the certificate was invalid, so it's always OK here: the refused ones
        # are recorded after the request, see record_refused_tls_connection().
        if ($sock->can('verify_hostname')) {
            my $reason;
            my $name = egress_name_of($response->request);
            if ($insecure) {
                if (defined $ca_store_error) {
                    $reason = "no usable CA store: $ca_store_error";
                }
                elsif (defined $cert_chain_error) {
                    $reason = $cert_chain_error;
                }
                elsif (!$sock->verify_hostname($name, 'www')) {
                    $reason = "certificate doesn't match $name";
                }
                $conn{'headers'}{'Client-SSL-Cert-Verify'} = defined $reason ? "FAILED ($reason)" : "OK";
            }

            push @tls_compliance,
              {
                host         => $name,
                ip           => $sock->peerhost // '',
                port         => $sock->peerport // '',
                verdict      => defined $reason ? 'failed' : 'ok',
                reason       => $reason                            // '',
                ssl_version  => $sock->get_sslversion              // '',
                ssl_cipher   => $sock->get_cipher                  // '',
                cert_subject => $sock->peer_certificate('subject') // '',
                cert_issuer  => $sock->peer_certificate('issuer')  // '',
              };
        }
        undef $cert_chain_error;    # consumed, the next handshake (if any) will set it again if needed
        return @ret;
    };

    # LWP::Protocol::https::_get_sock_info() calls the above, then sets the Client-SSL-* headers:
    # save them right away, before anything else coming from the device can be added to the response
    require LWP::Protocol::https;
    my $orig_https_get_sock_info = \&LWP::Protocol::https::_get_sock_info;
    *LWP::Protocol::https::_get_sock_info = sub {
        my ($self, $response, $sock, @rest) = @_;
        my @ret = $orig_https_get_sock_info->($self, $response, $sock, @rest);

        my $conn_headers = ($response->{$EGRESS_CONN_KEY} //= {headers => {}})->{'headers'};
        foreach my $name (@CLIENT_SSL_HEADERS) {
            my $value = $response->header($name);
            $conn_headers->{$name} = $value if defined $value;
        }
        # older versions of LWP::Protocol::https don't set Client-SSL-Version, do it ourselves
        if (   !defined $conn_headers->{'Client-SSL-Version'}
            && $sock->can('get_sslversion')
            && (my $sslversion = $sock->get_sslversion))
        {
            $conn_headers->{'Client-SSL-Version'} = $sslversion;
        }
        return @ret;
    };
}
## use critic

# Now build the UA for the request between bastion and remote device
# we don't want LWP to parse the HTML <head> of the device's answers, as it would add headers from
# <meta http-equiv> tags to the response, that would be indistinguishable from the real ones
my $ua = LWP::UserAgent->new(parse_head => 0);
$ua->agent("The Bastion " . $OVH::Bastion::VERSION);
$ua->timeout($timeout);
$ua->protocols_allowed($config->{'allowed_egress_protocols'});

# Redirects sent by the remote device: following them blindly would prevent us to check the new location
# against the account's or group's ACLs. Depending on the allow_redirects policy:
# - 'any': let our egress HTTP client follow them (GET/HEAD only)
# - 'same-host': follow them ourselves, but only if they point to the same scheme, host and port
#   (host-less redirects included), and always to the IP we've already checked. Otherwise, the 3xx answer
#   is relayed to the client, with the target in X-Bastion-Remote-Location
# - 'none': never follow them, the 3xx answer is relayed to the client as above
my $allow_redirects = $config->{'allow_redirects'};
my @denied_redirects;

# returns the absolute target URI of a redirect response, or undef if it's not a redirect LWP would follow
my $redirect_target = sub {
    my $response = shift;
    return if (not grep { $response->code == $_ } qw{ 301 302 303 307 308 });
    my $location = $response->header('Location');
    return if !defined $location;

    # resolve the Location against the URL of the redirected request itself, not $response->base,
    # as the latter can be influenced by the device (Content-Location header)
    return URI->new_abs($location, $response->request->uri);
};

# returns undef if the redirect from $from to $to is same-host, or the reason why it's not
my $not_same_host_reason = sub {
    my ($from, $to) = @_;

    # same scheme, as https => http would send the password in the clear, and same port,
    # as a different port is a different service from an ACL standpoint
    return "different scheme" if lc($to->scheme // '') ne lc($from->scheme);
    return "different port"   if (!$to->can('port') || $to->port ne $from->port);

    # host-less redirects have been resolved against $from, so they always match here,
    # otherwise accept the IP we've checked the ACLs against, or the hostname given by the client
    my $to_host = lc($to->host // '');
    return "different host" if ($to_host ne lc($remoteip) && $to_host ne lc($remotemachine));
    return;
};

if ($allow_redirects ne 'any') {

    # disable LWP's own redirect handling, as it wouldn't check the target
    my $redirectable = $ua->requests_redirectable;
    $ua->requests_redirectable([]);

    $ua->add_handler(
        response_redirect => sub {
            my ($response) = @_;
            my $to         = $redirect_target->($response) or return;
            my $from       = $response->request->uri;

            my $deny = sub {
                push @denied_redirects, {code => $response->code, from => "$from", to => "$to", reason => shift};
                return;
            };

            return $deny->("allow_redirects is set to none") if $allow_redirects eq 'none';

            my $reason = $not_same_host_reason->($from, $to);
            return $deny->("not same-host: $reason") if $reason;

            return $deny->("method " . $response->request->method . " is not redirectable")
              if (not grep { $response->request->method eq $_ } @{$redirectable || []});

            # build the new request, always to the IP we've checked (no new DNS resolution),
            # keeping the same headers (including the Host header, and the Authorization one)
            my $referral = $response->request->clone;
            $to->host($remoteip);
            $referral->uri($to);
            return $referral;
        }
    );
}

# we connect to the IP we've checked against the access lists, but the certificate must be validated against
# the name the client used to reach the device (and this name must be sent through SNI), as this is what
# a client would expect when connecting directly to the device. Without this, a device reached by hostname
# would have its certificate checked against its IP, which would fail for any regular certificate.
# When the client used an IP, we don't set SSL_hostname, as it would otherwise be sent through SNI, which is
# forbidden for IPs by RFC 6066: IO::Socket::SSL then validates the certificate against the IP we connect to.
# This is done before each request LWP sends, as the followed redirects might be for another name.
$ua->add_handler(
    request_prepare => sub {
        my ($request) = @_;
        my $name = egress_name_of($request);
        $ua->ssl_opts('SSL_hostname' => OVH::Bastion::is_valid_ip(ip => $name, fast => 1) ? undef : $name);
        return;
    }
);

# if specified, the egress certificates are verified against this CA file instead of the system's default CA store.
# This is set before the insecure handling below, so that the diagnostic of the insecure mode uses it too.
$ua->ssl_opts('SSL_ca_file' => $egress_ca_file) if $egress_ca_file;

# when insecure, we don't enforce the remote certificate validity, but we still check it, and report the result
# to our client through the X-Bastion-Remote-Client-SSL-Cert-Verify header. This is a diagnostic information,
# meant to ease the migration of an infrastructure to insecure=false, by detecting beforehand the devices
# that would be refused. We check the very same things LWP would have checked if insecure was false:
# the certificate chain against the same CA store (verified by OpenSSL during the handshake, even with
# SSL_VERIFY_NONE, we just record its verdict through a callback that never fails the handshake),
# and the certificate name against the name the client used, with the same 'www' scheme.
if ($insecure) {
    # ask LWP which CA store it would have used if verification was enabled (this differs between
    # distros: some LWP versions use Mozilla::CA, some are patched to use the system's bundle, etc.)
    # we use a throwaway UA with the same ssl_opts as ours, but verification enabled, to ask its https
    # implementation which socket options it would use. There's no public API for this, hence _extra_sock_opts()
    my %secure_opts;
    {
        my %ssl_opts  = map { $_ => $ua->ssl_opts($_) } $ua->ssl_opts;
        my $secure_ua = LWP::UserAgent->new(ssl_opts => {%ssl_opts, verify_hostname => 1});
        my $proto     = LWP::Protocol::https->new('https', $secure_ua);
        %secure_opts = eval { $proto->_extra_sock_opts($remoteip, $remoteport) };
        if ($@) {
            # LWP would have refused to even try to connect (e.g. no CA store found)
            chomp($ca_store_error = $@);
        }
    }
    foreach my $opt (qw{ SSL_ca_file SSL_ca_path SSL_ca }) {
        $ua->ssl_opts($opt => $secure_opts{$opt}) if defined $secure_opts{$opt};
    }

    $ua->ssl_opts('verify_hostname' => 0);
    $ua->ssl_opts('SSL_verify_mode' => IO::Socket::SSL::SSL_VERIFY_NONE);
    # OpenSSL calls this during the handshake, once per certificate of the chain and once more per error
    # encountered. We keep the first error, which is consumed (and reset) by our _get_sock_info() wrapper above
    # once the handshake is done, as a same worker can do several handshakes (downgrade retry, followed redirects).
    $ua->ssl_opts(
        'SSL_verify_callback' => sub {
            my ($ok, $ctx_store) = @_;
            if (!$ok && !defined $cert_chain_error) {
                # get a human-readable reason, such as "self-signed certificate"
                my $code = $ctx_store ? Net::SSLeay::X509_STORE_CTX_get_error($ctx_store) : 0;
                $cert_chain_error = ($code && Net::SSLeay::X509_verify_cert_error_string($code))
                  || "certificate verification failed";
            }
            return 1;    # never fail the handshake, we're insecure: only record the verdict
        }
    );
}
if ($config->{'egress_ciphers'}) {
    $ua->ssl_opts('SSL_cipher_list' => $config->{'egress_ciphers'});
}

# set the remote URL
my $req = HTTP::Request->new($method => $egress_protocol . "://" . $remotemachine_uri . ':' . $remoteport . $path);

# add the content we get (passthru)
$req->content($content);

# passthru some tolerated headers from client->bastion to bastion->device req
my %passthrough_headers;
foreach my $pattern (qw{ accept content-type content-length content-encoding x-test-[a-z-]+ }) {
    foreach my $header (grep { /^$pattern:/i } @client_headers) {
        my ($key, $value) = $header =~ /^([^:]+):\s*(.+)$/;
        $passthrough_headers{lc $key} = $value;
    }
}
foreach my $key (keys %passthrough_headers) {
    $req->header($key, $passthrough_headers{$key});
}
$req->header('Accept-Encoding' => scalar HTTP::Message::decodable());

# the remote server might need to have the original hostname to serve the proper contents
$req->header('Host' => $remotemachine);

# set the header to auth ourselves to the remote device
$req->header('Authorization', 'Basic ' . encode_base64($user . ':' . $device_password, ''));
undef $device_password;    # no longer needed

$req->header('X-Bastion-Auth-Mode',                 $authmode);
$req->header('X-Bastion-Ingress-Client-IP',         $ENV{'REMOTE_ADDR'});
$req->header('X-Bastion-Ingress-Client-Port',       $ENV{'REMOTE_PORT'});
$req->header('X-Bastion-Ingress-Client-User-Agent', $ENV{'HTTP_USER_AGENT'});
$req->header('X-Bastion-Ingress-Account',           $account);
$req->header('X-Bastion-UniqID',                    $uniqid);
$req->header('X-Bastion-Instance',                  Sys::Hostname::hostname());

my $start_time = [Time::HiRes::gettimeofday()];

# to handle timeout properly, we fork a child, he'll do the req, and we'll wait for it,
# potentially killing it if the timeout fires
my $pipe     = IO::Pipe->new;
my $childpid = fork();
if ($childpid == 0) {

    # we are the child: make the req and return the result to our parent
    $pipe->writer;
    my $res;
    my $downgraded = 0;

    # do the req a first time with defaults
    undef $cert_chain_error;
    $res = $ua->request($req);
    record_refused_tls_connection($res);

    # if we get a HTTP/1.0 500 Can't connect to A.B.C.D:443 (SSL connect attempt failed error:1425F102:SSL routines:ssl_choose_client_version:unsupported protocol)
    # or SSL connect attempt failed error:0A000102:SSL routines::unsupported protocol
    # or SSL connect attempt failed error:0A00014D:SSL routines::legacy sigalg disallowed or unsupported
    # (the latter happens on OpenSSL 3+ when the system policy doesn't forbid TLS < 1.2 but the device uses a SHA1-based signature)
    # then the device might be old and support TLS v1.0 maximum only. let's retry that silently if our caller allows.
    # on recent OpenSSL versions, some old ciphers might also need to be added-back, this is configurable through downgraded_egress_ciphers
    if (   $allow_downgrade
        && ($config->{'allow_downgrade'} // 1)
        && $res
        && $res->code == 500
        && is_lwp_internal_response($res)
        && $res->message =~ /:(?:unsupported protocol|legacy sigalg disallowed or unsupported)/)
    {
        $downgraded = 1;
        $ua->ssl_opts('SSL_version' => 'TLSv1');
        if ($config->{'downgraded_egress_ciphers'}) {
            $ua->ssl_opts('SSL_cipher_list' => $config->{'downgraded_egress_ciphers'});
        }
        undef $cert_chain_error;    # don't let a failed handshake of the first attempt leak into this one
        $res = $ua->request($req);
        record_refused_tls_connection($res);
    }
    # we can use freeze() instead of nfreeze() because the thaw() will be made by our parent,
    # which guarantees that we're using the same endianness, obviously
    $pipe->print(
        freeze(
            {
                res              => $res,
                downgraded       => $downgraded,
                denied_redirects => \@denied_redirects,
                tls_compliance   => \@tls_compliance,
            }
        )
    );
    exit;
}

# we are the parent: wait for our child but also consume the pipe to avoid blocking our child
$pipe->reader;
my $waiting_since  = time();
my $remaining_wait = $timeout;
my $child_data;
my $timed_out = 0;

while (1) {
    $remaining_wait = $timeout - (time() - $waiting_since);

    # we've waited long enough, bail out
    if ($remaining_wait <= 0) {
        $timed_out = 1;
        last;
    }

    my $select = IO::Select->new($pipe->fileno);
    my @ready  = $select->can_read($remaining_wait);

    # we either have something to read or timed out
    if (@ready) {

        # we have something to read
        my $newdata;
        my $nbread = $pipe->read($newdata, 4096);
        if (defined $nbread && $nbread > 0) {
            $child_data .= $newdata;
        }
        else {
            # 0 means EOF, undef means error
            last;
        }
    }
    else {
        # we timed out, bail out
        $timed_out = 1;
        last;
    }
}

my $res;
my $downgraded;
if (!$timed_out) {

    # get the result of the request of our child
    my $childresult = thaw($child_data);
    if (ref $childresult eq 'HASH') {
        $res              = $childresult->{'res'};
        $downgraded       = $childresult->{'downgraded'};
        @denied_redirects = @{$childresult->{'denied_redirects'} || []};
        @tls_compliance   = @{$childresult->{'tls_compliance'}   || []};
    }

}
else {
    # got a timeout, kill our child
    kill(9, $childpid);
}

my $delay = Time::HiRes::tv_interval($start_time, [Time::HiRes::gettimeofday()]);

# log what we got
my $basedir = "/home/$account/ttyrec";
-d $basedir || mkdir $basedir;

my $finaldir = "$basedir/$logsubdir";
-d $finaldir || mkdir $finaldir;

# depending on whether we must log the body or not, and whether there is a max size specified,
# prepare the log line about the body
my $body_to_log = "(BODY OMITTED)";
if ($res && $log_request_response) {
    $log_request_response_max_size //= 65536;
    if ($log_request_response_max_size && length($res->decoded_content) > $log_request_response_max_size) {
        $body_to_log =
            substr($res->decoded_content, 0, $log_request_response_max_size / 2)
          . '[...snip...]'
          . substr($res->decoded_content, -$log_request_response_max_size / 2);
    }
    else {
        $body_to_log = $res->decoded_content;
    }
}

my @now               = Time::HiRes::gettimeofday();
my @t                 = localtime($now[0]);
my @headerlog         = ($uniqid, $now[0], $now[1], POSIX::strftime("%Y/%m/%d.%H:%M:%S", @t));
my $headers_as_string = $res ? join("", $res->{'_headers'}->as_string("\n")) : '';
my $logfile           = sprintf("%s/%s.txt", $finaldir, POSIX::strftime("%F", @t));

# --- REDIRECT CHAIN AUDIT ---
# log the redirect chain we followed (if any), then the redirect we did not follow (if any)
my @redirect_chain_lines;
if ($res) {
    my $hop = 0;
    foreach my $r ($res->redirects) {
        $hop++;
        my $from           = $r->request->uri;
        my $to             = $redirect_target->($r);
        my $reason         = $to     ? $not_same_host_reason->($from, $to) : "unparseable target";
        my $classification = $reason ? "cross-host: $reason"               : 'same-host';
        push @redirect_chain_lines,
          sprintf("  HOP %d: %s %s -> %s [%s]", $hop, $r->code, $from, $to // '(none)', $classification);
    }
}
foreach my $denied (@denied_redirects) {
    push @redirect_chain_lines, sprintf("  NOT FOLLOWED: %s %s -> %s [%s]", @$denied{qw{ code from to reason }});
}

# if the device's final answer is a redirect (that we didn't follow), tell our client where the device wanted it to go
if ($res && (my $final_target = $redirect_target->($res))) {
    push @headers, ["X-Bastion-Remote-Location" => "$final_target"];
}
my $redirect_chain_log = @redirect_chain_lines ? join("\n", @redirect_chain_lines) : "(none)";

my $logline = sprintf(
    ""
      . "--- BASTION_REQUEST UNIQID=%s TIMESTAMP=%d.%06d DATE=%s ---\n%s\n"
      . "--- REDIRECT_CHAIN UNIQID=%s TIMESTAMP=%d.%06d DATE=%s ---\n%s\n"
      . "--- DEVICE_ANSWER UNIQID=%s TIMESTAMP=%d.%06d DATE=%s ---\n%s\n"
      . "--- END UNIQID=%s TIMESTAMP=%d.%06d DATE=%s ---\n\n",
    @headerlog,
    $req->as_string(),
    @headerlog,
    $redirect_chain_log,
    @headerlog,
    $res
    ? sprintf("%s %s\n%s\n%s", $res->protocol, $res->status_line, $headers_as_string, $body_to_log)
    : '(DEVICE TIMEOUT)',
    @headerlog,
);
$logline =~ s/^(Authorization:).+/$1 (removed)/mgi;

if (open(my $log, '>>', $logfile)) {
    flock($log, LOCK_EX);
    print $log $logline;
    flock($log, LOCK_UN);
    close($log);
}
else {
    warn("Couldn't open $logfile for log write");
}

# those are the headers we allow to come back from the remote server to the client
# we don't passthrough content-encoding, as we've already decoded the content (for logging purposes).
# header() is called in scalar context, so that a header present several times is joined into one value.
# The Client-SSL-* ones are not taken from the response headers, but from what we've saved, see _get_sock_info()
if ($res) {
    foreach my $name (qw{ Content-Type Content-Length }) {
        my $value = $res->header($name);
        push @headers, [$name => $value] if defined $value;
    }
    my $conn_headers = $res->{$EGRESS_CONN_KEY} ? $res->{$EGRESS_CONN_KEY}{'headers'} : {};
    foreach my $name (@CLIENT_SSL_HEADERS, 'Client-SSL-Cert-Verify') {
        push @headers, [$name => $conn_headers->{$name}] if defined $conn_headers->{$name};
    }
}
push @headers, ["X-Bastion-Remote-Status" => $res->status_line]      if $res;
push @headers, ["X-Bastion-Remote-Server" => $res->header('server')] if ($res && $res->header('server'));
push @headers, ["X-Bastion-Egress-Timing" => sprintf("%d", $delay * 1_000_000)];
push @headers, ["X-Bastion-Downgraded"    => 1] if $downgraded;

# log one line per egress TLS connection, telling whether it was accepted (or, when insecure, would have been
# accepted if insecure was false), along with the TLS version and cipher used. This way, an admin can easily find
# the non-compliant devices before switching to insecure=false, e.g. with: grep 'http-proxy-tls' | grep
# 'verdict="failed"', and get compliance stats on the TLS versions and ciphers used by the devices. The request
# path is not logged here as it's not relevant for compliance: it can be found in the access log, through uniqid.
foreach my $conn (@tls_compliance) {
    OVH::Bastion::syslogFormatted(
        criticity => 'info',
        type      => 'http-proxy-tls',
        fields    => [
            ['account',      $account],
            ['auth_mode',    $authmode],
            ['user',         $user],
            ['host',         $conn->{'host'}],
            ['ip',           $conn->{'ip'}],
            ['port',         $conn->{'port'}],
            ['enforced',     $insecure ? 0 : 1],
            ['verdict',      $conn->{'verdict'}],
            ['reason',       $conn->{'reason'}],
            ['ssl_version',  $conn->{'ssl_version'}],
            ['ssl_cipher',   $conn->{'ssl_cipher'}],
            ['cert_subject', $conn->{'cert_subject'}],
            ['cert_issuer',  $conn->{'cert_issuer'}],
            ['downgraded',   $downgraded ? 1 : 0],
        ]
    );
}

if ($res) {
    push @headers, ["X-Bastion-Local-Status" => "200 OK"];
    log_and_exit($res->code + 0, $res->message, $res->decoded_content, {});
}
else {
    push @headers, ["X-Bastion-Local-Status" => "504 Device Timeout"];
    log_and_exit(504, "Device Timeout", "Device Timeout\n", {comment => "device_timeout"});
}
